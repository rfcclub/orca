{
  "name": "@gotako/orca",
  "version": "1.6.2-beta.5",
  "description": "Intent-guided spec-driven design framework with TDD superpowers — Intent → Spec → TDD → Trust",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./property": "./dist/property/runtime.js",
    "./property/probe": "./dist/property/mutation.js",
    "./*": "./*"
  },
  "bin": {
    "orca": "dist/cli/index.js"
  },
  "files": [
    "dist",
    "schemas",
    "adapters",
    "USAGE.md",
    "docs/outcome-workflows.md",
    "docs/executable-evidence.md",
    "docs/property-evidence.md",
    "docs/loop-evidence.md",
    "examples/trading",
    "skills/verify",
    "skills/tdd",
    "skills/spec"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@gotako/pilotfish": "0.2.0-beta.3",
    "@types/node": "^25.6.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  },
  "publishConfig": {
    "access": "public"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@gotako/hammerhead-debug": "0.5.0-beta.0",
    "fast-check": "4.10.2",
    "seal-gate": "0.5.0",
    "yaml": "^2.8.3",
    "zod": "^4.3.6"
  }
}
